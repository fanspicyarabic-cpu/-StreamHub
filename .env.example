# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Project Configuration
# Either place serviceAccountKey.json in the project root OR provide FIREBASE_SERVICE_ACCOUNT as base64/JSON string
FIREBASE_PROJECT_ID=moves-app-2026-8a045
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# TMDB API Key (Optional - a free open mirror key is included as fallback in fullScraper.js)
TMDB_API_KEY=

# Scraper Settings
SCRAPER_START_PAGE=1
SCRAPER_MAX_PAGES=50
SCRAPER_DELAY_MS=1200

# Adsterra Direct Link Configuration (Replace with your own Adsterra direct link)
ADSTERRA_DIRECT_LINK=https://www.highperformancegate.com/your-adsterra-direct-link-id
